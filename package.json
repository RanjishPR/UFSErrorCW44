{
  "name": "incident-management",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.17.3",
    "@sap/cds": "^10.2.1",
    "@sap/cds-dk": "^10.2.0",
    "@sap/xssec": "^4",
    "@ui5/cli": "^4.0.71",
    "eslint": "^10.13.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test --test-timeout=30000 test/test.js",
    "start": "cds-serve",
    "watch-incidentscw40": "cds watch --open ns.incidentscw40/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manager": "cds watch --open ns.manager/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "support"
              ]
            },
            "bob": {
              "roles": [
                "admin"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/incidentscw40",
    "app/manager"
  ]
}





